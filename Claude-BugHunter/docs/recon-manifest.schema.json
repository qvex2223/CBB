{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elementalsouls/Claude-BugHunter/blob/main/docs/recon-manifest.schema.json",
  "title": "Recon \u2192 Hunt Manifest",
  "description": "Data contract between the recon phase (cbh recon / engine recon / offensive-osint) and the hunt phase (hunt / cbh surface / cbh vectors seed-from-manifest / /hunt).",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "generated_at",
    "assets",
    "ranked_surface"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "2.0"
      ],
      "description": "2.0 adds `operations`: normalized API operations, the unit the hunt side seeds vectors from."
    },
    "target": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "subdomains": {
          "type": "integer"
        },
        "resolved": {
          "type": "integer"
        },
        "live": {
          "type": "integer"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "type": "string"
          },
          "ips": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "server": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tech": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "ranked_surface": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "priority"
        ],
        "properties": {
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "type": "string"
          },
          "bug_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "KILL"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "identity_fabric": {
      "type": "object"
    },
    "operations": {
      "type": "array",
      "description": "Normalized API operations (schema 2.0+). One entry per (method, host, canonical path): numeric ids, UUIDs and OpenAPI path variables all normalize to {id}, so a spec and captured traffic merge into one row. Produced by engine/api_manifest.py; consumed by engine/workflow_graph.py and `cbh vectors seed-from-manifest`.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "op_<sha256[:12]> of METHOD host canonical-path"
          },
          "method": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "canonical path, variables normalized to {id}"
          },
          "operation_name": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "request/response schema field names"
          },
          "secured": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "declared auth requirement; null when the source does not say"
          },
          "risk_hints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "object-authorization | state-change | property-authorization | function-authorization | oauth | graphql | business-flow | declared-public \u2014 what justifies attacking this operation"
          },
          "source": {
            "type": "string",
            "description": "openapi | har | postman | burp | graphql | crawl"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  }
}
