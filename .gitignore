# Engagement data stays local. Unfixed third-party vulnerability detail must not
# be published pre-fix (CLAUDE.md safety floor, and every program's own rules).
# Only the scaffold a new engagement is copied from is versioned.
/Targets/*
!/Targets/_TEMPLATE/

# Engagement scratch that lands at the repo root instead of in Targets/<name>/
# `fired.txt` is a host+method+path map of everything a hunt actually sent: engagement
# data, and the one root-level file `git add -A` would otherwise publish.
/fired*.txt
/co-handshake.json
/cbh-h16-paths.json
/need-status.txt

# Engagement-specific replay baselines and plans (lead/primitive titles of private programmes). Never publish.
docs/plans/
