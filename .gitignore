# Response corpus — every body bbcurl captured, keyed by sha256. Same class of
# content as evidence/: other users' data, session state, PII. Working cache with
# an expiry (`cbh memory-gc --prune-responses N --rotate`), never versioned.
hunt-memory/responses/

# Evidence — screenshots/HAR/raw captures. Contain session cookies and other
# users' PII by nature. Never versioned, never shared raw (see CLAUDE.md).
Targets/*/evidence/
*.har

# Go module cache — 676M of third-party source, reinstallable.
go/

# caveman/ is its own upstream git clone, not our code.
caveman/

# Python bytecode
__pycache__/
*.py[cod]

# Playwright MCP scratch output
.playwright-mcp/

# Local harness state
.claude/scheduled_tasks.lock

# Generated by `cbh view` — rebuilt from findings/, hosts/ and notes.md on demand.
Targets/*/dashboard.html

# Pacing lock/timestamp state. Per-machine runtime, meaningless in history.
hunt-memory/pacing/

# Installed MCP dependencies and per-session tool state.
**/node_modules/
Claude-BugHunter/runtime/state/
Claude-BugHunter/runtime/artifacts/
Claude-BugHunter/runtime/logs/
hunt-memory/tool-usage/

# ---------------------------------------------------------------- captured traffic
# audit.jsonl is the raw request log: URLs and header lines from live programs. Writers
# now mask identity fields (engine/responses.py:scrub_text), but a request log is still
# the wrong thing to version - it only ever grows and it is pure liability in history.
hunt-memory/audit.jsonl
hunt-memory/audit.jsonl.*

# poc_runtime evidence: FULL request + response per step, the densest PII surface the
# toolchain writes. Same class as Targets/*/evidence/ - keep it local, cite it by name
# from the report. The .poc.json SPEC stays versioned: it is the reproducible part and
# must never carry a real identity in the first place (use synthetic 777000xxxx + a
# locally generated IIN, see blocked-tests/17).
Targets/*/findings/*.result.json

# ---------------------------------------------------------------- CBB repo additions
# Engagement folders are never versioned here — only Targets/_TEMPLATE/ ships.
Targets/*
!Targets/_TEMPLATE/

# hunt-memory ships as structure only (see hunt-memory/README.md).
hunt-memory/*.jsonl
hunt-memory/*.jsonl.*
hunt-memory/targets/*.json

# Node deps for the MCP wrappers — reinstall with `npm install` in runtime/.
Claude-BugHunter/runtime/node_modules/

# One-off engagement browser scripts: real logins/targets, not part of the tool.
Claude-BugHunter/runtime/*.cjs

# Local runtime logs and editor backups.
Claude-BugHunter/logs/
*.bak-*
*.pre-corpus
Claude-BugHunter/eval/workdir/
Claude-BugHunter/eval/tier3_ws/hunt-memory/
